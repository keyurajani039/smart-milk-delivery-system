<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="10" author="smart-milk">
        <createTable tableName="extra_customer_sales">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT"/>
            <column name="sale_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="quantity_liters" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="amount_collected" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="payment_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="VARCHAR(255)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="extra_customer_sales" baseColumnNames="user_id" constraintName="fk_extra_sales_user" referencedTableName="users" referencedColumnNames="id" onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="11" author="smart-milk">
        <createTable tableName="delivery_sessions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT"/>
            <column name="started_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="ended_at" type="DATETIME"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="loaded_milk_quantity" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="delivery_sessions" baseColumnNames="user_id" constraintName="fk_delivery_session_user" referencedTableName="users" referencedColumnNames="id" onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="12" author="smart-milk">
        <addColumn tableName="customers">
            <column name="extra_milk_start_date" type="DATE"/>
        </addColumn>
    </changeSet>

    <changeSet id="13" author="smart-milk">
        <createTable tableName="plan_cancellations">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="cancellation_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="reason" type="VARCHAR(500)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="plan_cancellations" baseColumnNames="customer_id" constraintName="fk_cancellation_customer" referencedTableName="customers" referencedColumnNames="id" onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="14" author="smart-milk">
        <addColumn tableName="users">
            <column name="upi_id" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="15" author="smart-milk">
        <createTable tableName="subscription_payments">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="subscription_plan_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="razorpay_order_id" type="VARCHAR(255)"/>
            <column name="razorpay_payment_id" type="VARCHAR(255)"/>
            <column name="amount" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="payment_status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="subscription_payments" baseColumnNames="user_id" constraintName="fk_sub_pay_user" referencedTableName="users" referencedColumnNames="id" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="subscription_payments" baseColumnNames="subscription_plan_id" constraintName="fk_sub_pay_plan" referencedTableName="subscription_plans" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
